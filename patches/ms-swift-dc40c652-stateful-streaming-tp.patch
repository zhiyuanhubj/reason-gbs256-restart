+        item = None
+        try:
+            item = next(self.iterator)
+        except StopIteration:
+            local_available = False
+
+        available = torch.tensor(
+            [int(local_available)], dtype=torch.int32, device=get_current_device())
+        torch.distributed.all_reduce(available, op=torch.distributed.ReduceOp.MIN)
+        if not bool(available.item()):
+            self.exhausted = True
+            del item
+            raise _FiniteStreamExhausted
+        return item
